TRADING_ENV=development
TRADING_DEMO_MODE=true
TRADING_EXECUTION_MODE=internal-paper
TRADING_STARTING_CASH=100000
TRADING_SYMBOLS=AAPL,MSFT,NVDA,AVGO,ORCL,CRM,CSCO,ADBE,AMD,V,MA,GOOGL,META,NFLX,DIS,TMUS,AMZN,TSLA,HD,MCD,NKE,LOW,WMT,COST,PG,KO,PEP,UNH,LLY,JNJ,MRK,ABBV,TMO,ABT,JPM,BAC,WFC,GS,MS,CAT,GE,RTX,HON,UPS,XOM,CVX,COP,NEE
TRADING_UNIVERSE_MANIFEST_PATH=config/universes/us-liquid-large-cap-v1.json
TRADING_DECISION_INTERVAL_SECONDS=3
TRADING_MAX_POSITION_PCT=0.05
TRADING_MAX_GROSS_EXPOSURE_PCT=0.60
TRADING_MAX_LONG_POSITION_PCT=0.05
TRADING_MAX_SHORT_POSITION_PCT=0.03
TRADING_MAX_GROSS_LONG_EXPOSURE_PCT=0.60
TRADING_MAX_GROSS_SHORT_EXPOSURE_PCT=0.30
TRADING_INITIAL_MARGIN_REQUIREMENT=0.50
TRADING_MAINTENANCE_MARGIN_REQUIREMENT=0.30
# Short opening fails closed unless a symbol is explicitly listed as easy to borrow.
TRADING_EASY_TO_BORROW_SYMBOLS=
TRADING_BORROW_STATUS_MAX_AGE_SECONDS=300
TRADING_BORROW_RATE_ANNUAL=0.03
TRADING_DIVIDEND_REPLACEMENT_RATE_ANNUAL=0.02
TRADING_SLIPPAGE_BPS=2
TRADING_COMMISSION_BPS=0
TRADING_REGULATORY_SELL_FEE_BPS=0.05
TRADING_MARKET_IMPACT_STRESS_BPS=2
TRADING_MARGIN_INTEREST_RATE_ANNUAL=0.08
# Funding conversion is explicit and is never charged on every trade.
TRADING_PLN_TO_USD_CONVERSION_BPS=0
TRADING_PLN_TO_USD_CONVERSION_AMOUNT_USD=0
# Reporting estimate only; this is not tax advice.
TRADING_ESTIMATED_POLISH_CAPITAL_GAINS_RATE=0.19
TRADING_MAX_DAILY_LOSS_PCT=0.01
TRADING_MAX_DRAWDOWN_PCT=0.08
TRADING_MIN_CONFIDENCE=0.65
TRADING_MAX_SPREAD_BPS=35
TRADING_MAX_DATA_AGE_SECONDS=30
TRADING_MAX_TRADES_PER_DAY=10
TRADING_ORDER_FILL_TIMEOUT_SECONDS=15
TRADING_ORDER_POLL_INTERVAL_SECONDS=0.25
# Set this for any deployment beyond a trusted local machine.
TRADING_CONTROL_API_KEY=
TRADING_DATABASE_PATH=.trading/events.db
TRADING_STRATEGY_MODE=explainable
TRADING_MODEL_REGISTRY_PATH=.trading/models
# Optional explicit issuer/subsidiary/supplier/customer/competitor catalog.
TRADING_ENTITY_CATALOG_PATH=
TRADING_CORS_ORIGINS=http://localhost:3000

ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_NEWS_STREAM_URL=wss://stream.data.alpaca.markets/v1beta1/news

# SEC requests require a descriptive application name and contact email.
SEC_USER_AGENT=Trading Research your-email@example.com
SEC_DATA_BASE_URL=https://data.sec.gov
